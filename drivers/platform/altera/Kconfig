config ALTERA_PLATFORM_NIOSV
	bool "Use Nios V / Intel FPGA BSP compatibility"
	default n
	help
	  Enable the external BSP compatibility layer for Nios V / Intel FPGA.
	  When enabled, the Altera toolchain selects the Nios V flow and expects
	  ALTERA_NIOSV_REPO_DIR(reference design with hw/, sw/), ALTERA_NIOSV_BSP(niosv-bsp path)

if ALTERA_PLATFORM_NIOSV

config GPIO_ALTERA
	bool "Enable Altera GPIO driver"
	depends on GPIO
	default n
	help
	  Enable the legacy Altera Avalon-SOPC GPIO driver implementation.
	  Requires CONFIG_GPIO=y and a hardware design with the corresponding
	  Avalon GPIO IP core.

config I2C_ALTERA
	bool "Enable Altera I2C driver"
	depends on I2C
	default n
	help
	  Enable the legacy Altera Avalon-SOPC I2C driver implementation.
	  Requires CONFIG_I2C=y and a hardware design with the corresponding
	  Avalon I2C IP core.

config SPI_ALTERA
	bool "Enable Altera SPI driver"
	depends on SPI
	default n
	help
	  Enable the legacy Altera Avalon-SOPC SPI driver implementation.
	  Requires CONFIG_SPI=y and a hardware design with the corresponding
	  Avalon SPI IP core.

config IRQ_ALTERA
	bool "Enable Altera IRQ driver"
	depends on IRQ
	default n
	help
	  Enable the Altera / Nios V core-local interrupt controller (CLIC/CLINT)
	  driver, which wraps the generated BSP HAL alt_ic_* / alt_irq_* API.
	  Requires CONFIG_IRQ=y.

config UART_ALTERA
	bool "Enable Altera UART driver"
	depends on UART
	select IRQ
	select IRQ_ALTERA
	default n
	help
	  Enable the Altera / Nios V Avalon JTAG-UART driver (polled TX, hybrid
	  interrupt + polled RX). Needed for the IIO server transport. Requires
	  CONFIG_UART=y and pulls in the Altera IRQ driver.

endif # ALTERA_PLATFORM_NIOSV
