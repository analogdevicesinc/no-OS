menuconfig ACCEL
    bool "Accelerometer Drivers"
    default n
    help
      Enable support for accelerometer drivers.

if ACCEL

config ACCEL_ADXL313
    depends on SPI
    select GPIO
    bool "Enable the ADXL313 driver"
    default n

config ACCEL_IIO_ADXL313
    depends on SPI
    select ACCEL_ADXL313
    bool "Enable the ADXL313 IIO driver"
    default n

config ACCEL_ADXL355
    depends on SPI
    select GPIO
    bool "Enable the ADXL355 driver"
    default n

config ACCEL_IIO_ADXL355
    depends on SPI
    select ACCEL_ADXL355
    bool "Enable the ADXL355 IIO driver"
    default n

config ACCEL_ADXL367
    depends on SPI
    bool "Enable the ADXL367 driver"
    default n

config ACCEL_IIO_ADXL367
    depends on SPI
    select ACCEL_ADXL367
    bool "Enable the ADXL367 IIO driver"
    default n

config ACCEL_ADXL38X
    depends on SPI
    select GPIO
    bool "Enable the ADXL38X driver"
    default n

config ACCEL_ADXL37X
    depends on SPI && I2C
    select GPIO
    bool "Enable the ADXL37X driver"
    default n
    help
      The driver picks the bus at runtime via adxl37x_init_param.comm_type,
      so both SPI and I2C back ends are always linked in.

config ACCEL_IIO_ADXL37X
    depends on SPI && I2C
    select ACCEL_ADXL37X
    bool "Enable the ADXL37X IIO driver"
    default n

endif
