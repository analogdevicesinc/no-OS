+#if LWIP_UDP
+
+/** Call the report function of an iperf udp session */
+static void
+lwiperf_udp_report(lwiperf_state_udp_t *conn, enum lwiperf_report_type report_type)
+{
+  if ((conn != NULL) && (conn->report_fn != NULL)) {
+    u32_t now, duration_ms, bandwidth_kbitpsec;
+    now = sys_now();
+    duration_ms = now - conn->time_started;
+    if (duration_ms == 0) {
+      bandwidth_kbitpsec = 0;
+    } else {
+      bandwidth_kbitpsec = (conn->total_len_lo / duration_ms) * 8U;
+    }
+    conn->report_fn(conn->report_arg, report_type,
+                    &conn->pcb->local_ip, conn->pcb->local_port,
+                    &conn->remote_addr, conn->remote_port,
+                    conn->total_len_lo, duration_ms, bandwidth_kbitpsec);
+  }
+}
+
+/** (Re)start a measurement: reset all running statistics */
+static void
+lwiperf_udp_stats_reset(lwiperf_state_udp_t *conn, const ip_addr_t *addr, u16_t port)
+{
+  ip_addr_copy(conn->remote_addr, *addr);
+  conn->remote_port = port;
+  conn->have_stats = 1;
+  conn->finished = 0;
+  conn->time_started = sys_now();
+  conn->packet_id = 0;
+  conn->cnt_datagrams = 0;
+  conn->cnt_error = 0;
+  conn->cnt_outoforder = 0;
+  conn->total_len_lo = 0;
+  conn->total_len_hi = 0;
+  conn->jitter = 0.0;
+  conn->last_transit = 0.0;
+  conn->transit_cnt = 0;
+  conn->ipg_last_us = 0;
+  conn->ipg_sum = 0.0;
+}
+
+/** Add 'len' payload bytes to the 64-bit total counter */
+static void
+lwiperf_udp_add_bytes(lwiperf_state_udp_t *conn, u16_t len)
+{
+  u32_t prev = conn->total_len_lo;
+  conn->total_len_lo = prev + len;
+  if (conn->total_len_lo < prev) {
+    conn->total_len_hi++;
+  }
+}
+
+/** Split a non-negative seconds value into iperf's (seconds, microseconds)
+ * word pair, both in network byte order. */
+static void
+lwiperf_udp_split_sec(double seconds, u32_t *w1, u32_t *w2)
+{
+  u32_t whole;
+  if (seconds < 0.0) {
+    seconds = 0.0;
+  }
+  whole = (u32_t)seconds;
+  *w1 = lwip_htonl(whole);
+  *w2 = lwip_htonl((u32_t)((seconds - (double)whole) * 1000000.0));
+}
+
+/** Send the iperf server report ("AckFIN") back to the client.
+ * The report carries the base server_hdr followed by the server_hdr_extension;
+ * the HEADER_EXTEND flag plus a non-zero cntIPG are what make the client print
+ * the loss percentage and jitter (rather than zeros). */
+static void
+lwiperf_udp_send_report(lwiperf_state_udp_t *conn, const ip_addr_t *addr, u16_t port)
+{
+  struct pbuf *p;
+  lwiperf_udp_datagram_t *hdr;
+  lwiperf_udp_srv_hdr_t *srv;
+  lwiperf_udp_srv_hdr_ext_t *ext;
+  u32_t duration_ms, error_cnt;
+
+  p = pbuf_alloc(PBUF_TRANSPORT,
+                 (u16_t)(sizeof(lwiperf_udp_datagram_t) + sizeof(lwiperf_udp_srv_hdr_t) +
+                         sizeof(lwiperf_udp_srv_hdr_ext_t)),
+                 PBUF_RAM);
+  if (p == NULL) {
+    return;
+  }
+
+  hdr = (lwiperf_udp_datagram_t *)p->payload;
+  memset(hdr, 0, sizeof(*hdr));
+  hdr->id = (s32_t)lwip_htonl((u32_t)(-conn->packet_id));
+
+  srv = (lwiperf_udp_srv_hdr_t *)(hdr + 1);
+  duration_ms = sys_now() - conn->time_started;
+
+  /* iperf settles the loss count against the out-of-order count */
+  error_cnt = conn->cnt_error;
+  if (error_cnt > conn->cnt_outoforder) {
+    error_cnt -= conn->cnt_outoforder;
+  }
+
+  srv->flags        = lwip_htonl(LWIPERF_UDP_HEADER_VERSION1 | LWIPERF_UDP_HEADER_EXTEND);
+  srv->total_len1   = lwip_htonl(conn->total_len_hi);
+  srv->total_len2   = lwip_htonl(conn->total_len_lo);
+  srv->stop_sec     = lwip_htonl(duration_ms / 1000U);
+  srv->stop_usec    = lwip_htonl((duration_ms % 1000U) * 1000U);
+  srv->error_cnt    = lwip_htonl(error_cnt);
+  srv->outorder_cnt = lwip_htonl(conn->cnt_outoforder);
+  /* for UDP, iperf reports the highest sequence number as datagram count */
+  srv->datagrams    = lwip_htonl((u32_t)conn->packet_id);
+  lwiperf_udp_split_sec(conn->jitter, &srv->jitter1, &srv->jitter2);
+
+  ext = (lwiperf_udp_srv_hdr_ext_t *)(srv + 1);
+  memset(ext, 0, sizeof(*ext));
+  /* One-way latency is unmeasurable: the client and server clocks are not
+   * synchronised. Flag the transit data as unavailable so the client drops the
+   * latency avg/min/max/stdev and net-power columns (rather than showing a
+   * misleading 0.000), while still printing jitter, loss and pps. */
+  ext->minTransit1 = lwip_htonl((u32_t)LWIPERF_UDP_TRANSIT_UNAVAIL);
+  /* cntIPG must be non-zero for the client to print jitter and loss %. It is
+   * the number of inter-packet gaps; IPGsum is their total duration in seconds,
+   * together giving the packets-per-second figure. */
+  ext->cntIPG      = lwip_htonl(conn->transit_cnt);
+  ext->IPGsum      = lwip_htonl((u32_t)conn->ipg_sum);
+
+  udp_sendto(conn->pcb, p, addr, port);
+  pbuf_free(p);
+}
+
+/** UDP receive callback: process an incoming iperf datagram */
+static void
+lwiperf_udp_recv(void *arg, struct udp_pcb *pcb, struct pbuf *p,
+                 const ip_addr_t *addr, u16_t port)
+{
+  lwiperf_state_udp_t *conn = (lwiperf_state_udp_t *)arg;
+  lwiperf_udp_datagram_t dg;
+  s32_t seq;
+  u16_t datagram_len;
+
+  LWIP_UNUSED_ARG(pcb);
+
+  if ((conn == NULL) || (p == NULL)) {
+    if (p != NULL) {
+      pbuf_free(p);
+    }
+    return;
+  }
+
+  datagram_len = p->tot_len;
+
+  /* Every iperf datagram carries at least the 12-byte header */
+  if (datagram_len < sizeof(lwiperf_udp_datagram_t)) {
+    pbuf_free(p);
+    return;
+  }
+  if (pbuf_copy_partial(p, &dg, sizeof(dg), 0) != sizeof(dg)) {
+    pbuf_free(p);
+    return;
+  }
+  pbuf_free(p);
+
+  seq = (s32_t)lwip_ntohl((u32_t)dg.id);
+
+  /* Is there a measurement in progress for exactly this client? */
+  if (conn->have_stats &&
+      ip_addr_eq(&conn->remote_addr, addr) && (conn->remote_port == port)) {
+    if (conn->finished) {
+      /* The test for this client already ended. iperf retransmits the final
+       * (negative-id) datagram up to 10 times until it reads back our server
+       * report, so re-send the report and drop the datagram without
+       * re-reporting. A non-negative id here means the client has started a
+       * brand new test, so fall through to reset. */
+      if (seq < 0) {
+        lwiperf_udp_send_report(conn, addr, port);
+        return;
+      }
+      lwiperf_udp_stats_reset(conn, addr, port);
+    }
+    /* else: measurement ongoing, keep accumulating below */
+  } else {
+    /* A different client, or the first datagram ever. A stray negative-id
+     * datagram that matches no running session is ignored. */
+    if (seq < 0) {
+      return;
+    }
+    lwiperf_udp_stats_reset(conn, addr, port);
+  }
+
+  conn->cnt_datagrams++;
+
+  if (seq < 0) {
+    /* final datagram of the running test: the client negated the sequence
+     * number. Count it, send the server report and report the result once. */
+    lwiperf_udp_add_bytes(conn, datagram_len);
+    conn->finished = 1;
+    lwiperf_udp_send_report(conn, addr, port);
+    lwiperf_udp_report(conn, LWIPERF_UDP_DONE_SERVER);
+    return;
+  }
+
+  lwiperf_udp_add_bytes(conn, datagram_len);
+
+  /* id 0 is the connection/settings datagram; skip loss & jitter for it */
+  if (seq != 0) {
+    u32_t arrival_us = lwiperf_udp_now_us();
+    double now_s = (double)arrival_us / 1000000.0;
+    double client_s = (double)lwip_ntohl(dg.tv_sec) +
+                      (double)lwip_ntohl(dg.tv_usec) / 1000000.0;
+    /* Transit carries a constant client/server clock offset (the two clocks are
+     * unsynchronised), so its absolute value is meaningless and we do not report
+     * one-way latency. The offset cancels in the jitter delta below, and the
+     * inter-packet gap is measured purely from server arrival times. */
+    double transit = now_s - client_s;
+
+    /* RFC 1889 jitter: J = J + (|D(i-1,i)| - J) / 16 */
+    if (conn->last_transit != 0.0) {
+      double delta = transit - conn->last_transit;
+      if (delta < 0.0) {
+        delta = -delta;
+      }
+      conn->jitter += (delta - conn->jitter) / 16.0;
+
+      /* inter-packet gap between consecutive arrivals (server clock only) */
+      if (conn->ipg_last_us != 0) {
+        conn->ipg_sum += (double)(arrival_us - conn->ipg_last_us) / 1000000.0;
+      }
+    }
+    conn->last_transit = transit;
+    conn->ipg_last_us = arrival_us;
+    conn->transit_cnt++; /* counts inter-packet-gap samples for cntIPG/pps */
+
+    /* packet loss / reordering: sequence numbers should be contiguous */
+    if (seq != conn->packet_id + 1) {
+      if (seq < conn->packet_id + 1) {
+        conn->cnt_outoforder++;
+      } else {
+        conn->cnt_error += (u32_t)(seq - conn->packet_id - 1);
+      }
+    }
+    if (seq > conn->packet_id) {
+      conn->packet_id = seq;
+    }
+  }
+}
+
+/**
+ * @ingroup iperf
+ * Start a UDP iperf server on a specific IP address and port and listen for
+ * incoming datagrams from iperf clients.
+ *
+ * @returns a connection handle that can be used to abort the server
+ *          by calling @ref lwiperf_abort()
+ */
+void *
+lwiperf_start_udp_server(const ip_addr_t *local_addr, u16_t local_port,
+                         lwiperf_report_fn report_fn, void *report_arg)
+{
+  err_t err;
+  struct udp_pcb *pcb;
+  lwiperf_state_udp_t *s;
+
+  LWIP_ASSERT_CORE_LOCKED();
+
+  if (local_addr == NULL) {
+    return NULL;
+  }
+
+  s = (lwiperf_state_udp_t *)LWIPERF_ALLOC(lwiperf_state_udp_t);
+  if (s == NULL) {
+    return NULL;
+  }
+  memset(s, 0, sizeof(lwiperf_state_udp_t));
+  s->base.tcp = 0;
+  s->base.server = 1;
+  s->report_fn = report_fn;
+  s->report_arg = report_arg;
+
+  pcb = udp_new_ip_type(LWIPERF_SERVER_IP_TYPE);
+  if (pcb == NULL) {
+    LWIPERF_FREE(lwiperf_state_udp_t, s);
+    return NULL;
+  }
+  err = udp_bind(pcb, local_addr, local_port);
+  if (err != ERR_OK) {
+    udp_remove(pcb);
+    LWIPERF_FREE(lwiperf_state_udp_t, s);
+    return NULL;
+  }
+  s->pcb = pcb;
+  udp_recv(pcb, lwiperf_udp_recv, s);
+
+  lwiperf_list_add(&s->base);
+  return s;
+}
+
+/**
+ * @ingroup iperf
+ * Start a UDP iperf server on the default UDP port (5001) and listen for
+ * incoming datagrams from iperf clients.
+ *
+ * @returns a connection handle that can be used to abort the server
+ *          by calling @ref lwiperf_abort()
+ */
+void *
+lwiperf_start_udp_server_default(lwiperf_report_fn report_fn, void *report_arg)
+{
+  return lwiperf_start_udp_server(IP_ADDR_ANY, LWIPERF_UDP_PORT_DEFAULT,
+                                  report_fn, report_arg);
+}
+
+/* ------------------------------------------------------------------------- */
+/* UDP client                                                                */
+/* ------------------------------------------------------------------------- */
+
+/** Default send rate when the caller passes rate_bps == 0 (~1 Mbit/s). */
+#define LWIPERF_UDP_CLIENT_RATE_DEF 1000000U
+/** Default transfer amount: negative value is time in hundredths of a second,
+ * so -1000 means a 10-second test (iperf's default). */
+#define LWIPERF_UDP_CLIENT_AMOUNT_DEF (-1000)
+/** How often the final (FIN) datagram is retransmitted while waiting for the
+ * server's report, and the maximum number of attempts. */
+#define LWIPERF_UDP_CLIENT_FIN_MS    250U
+#define LWIPERF_UDP_CLIENT_FIN_TRIES 10U
+/** Pacing timer period: the send callback reschedules this often, and also
+ * catches up on any datagrams owed since it last ran. Kept small so the rate
+ * stays smooth. */
+#define LWIPERF_UDP_CLIENT_TICK_MS   2U
+/** Upper bound on datagrams offered in a single callback, so a long scheduling
+ * gap does not turn into an unbounded burst that monopolises the CPU. This only
+ * caps per-callback catch-up work; it does not limit the offered rate over
+ * time (the remainder is offered on the next tick). */
+#define LWIPERF_UDP_CLIENT_MAX_BURST 64U
+
+/** Deliver the client-side report and tear the session down */
+static void
+lwiperf_udp_client_finish(lwiperf_state_udp_client_t *c,
+                          enum lwiperf_report_type report_type)
+{
+  if (c->done) {
+    return;
+  }
+  c->done = 1;
+  sys_untimeout(lwiperf_udp_client_tick, c);
+  sys_untimeout(lwiperf_udp_client_fin_tick, c);
+
+  if (c->report_fn != NULL) {
+    u32_t now = sys_now();
+    u32_t duration_ms = now - c->time_started;
+    /* Report the bytes actually accepted for transmission (what reached the
+     * wire), which is the honest client-side throughput. The difference from
+     * the offered total is the local drop count the server also observes. */
+    u32_t bw_kbitps = (duration_ms == 0) ? 0 :
+                      (c->bytes_delivered / duration_ms) * 8U;
+    c->report_fn(c->report_arg, report_type,
+                 &c->pcb->local_ip, c->pcb->local_port,
+                 &c->remote_addr, c->remote_port,
+                 c->bytes_delivered, duration_ms, bw_kbitps);
+  }
+
+  lwiperf_list_remove(&c->base);
+  if (c->pcb != NULL) {
+    udp_remove(c->pcb);
+    c->pcb = NULL;
+  }
+  LWIPERF_FREE(lwiperf_state_udp_client_t, c);
+}
+
+/** Fill and send one data datagram with the given sequence id.
+ *
+ * Mirrors iperf's UDP client: the datagram is stamped and handed to the stack
+ * with a single udp_sendto(), exactly as iperf hands each datagram to write().
+ * The return value is the real result: ERR_OK if the frame was accepted for
+ * transmission, or an error if the stack/driver rejected it (e.g. the MAC TX
+ * buffers are full). A rejected datagram is a genuine drop - the caller still
+ * advances the sequence number (as iperf does), so the server sees the gap and
+ * reports it as loss. This reflects the actual behaviour of the driver/link,
+ * with nothing fabricated by the client. */
+static err_t
+lwiperf_udp_client_send_one(lwiperf_state_udp_client_t *c, s32_t id)
+{
+  struct pbuf *p;
+  lwiperf_udp_datagram_t *hdr;
+  err_t err;
+  u32_t now_us = lwiperf_udp_now_us();
+
+  hdr = (lwiperf_udp_datagram_t *)c->txbuf;
+  hdr->id     = (s32_t)lwip_htonl((u32_t)id);
+  hdr->tv_sec = lwip_htonl(now_us / 1000000U);
+  hdr->tv_usec = lwip_htonl(now_us % 1000000U);
+  hdr->id2    = 0;
+
+  p = pbuf_alloc(PBUF_TRANSPORT, c->buffer_len, PBUF_RAM);
+  if (p == NULL) {
+    return ERR_MEM;
+  }
+  pbuf_take(p, c->txbuf, c->buffer_len);
+  err = udp_sendto(c->pcb, p, &c->remote_addr, c->remote_port);
+  pbuf_free(p);
+  return err;
+}
+
+/** Timer callback: send the scheduled datagrams, then reschedule or finish */
+static void
+lwiperf_udp_client_tick(void *arg)
+{
+  lwiperf_state_udp_client_t *c = (lwiperf_state_udp_client_t *)arg;
+  u32_t elapsed_ms = sys_now() - c->time_started;
+  u8_t test_done = 0;
+  u32_t burst = 0;
+  u64_t target_bytes;
+
+  if (c->time_mode && (elapsed_ms >= c->amount)) {
+    test_done = 1;
+  }
+
+  if (!test_done) {
+    /* Rate pacing, as in iperf: how many payload bytes the requested rate calls
+     * for by now. We offer datagrams up to that. Every offered datagram is
+     * stamped, handed to udp_sendto() once, and has its sequence number
+     * advanced - regardless of whether the stack accepts it. If the stack/
+     * driver rejects it (real ENOBUFS when the MAC TX buffers are full), that
+     * is a genuine drop: the sequence number is still consumed, so the server
+     * sees the gap and reports the true loss of the driver/link. Nothing about
+     * the loss is synthesised by the client. */
+    target_bytes = ((u64_t)c->rate_bps * (u64_t)elapsed_ms) / 8000U;
+
+    while ((u64_t)c->bytes_transferred < target_bytes) {
+      if (!c->time_mode && (c->bytes_transferred >= c->amount)) {
+        test_done = 1;
+        break;
+      }
+
+      if (lwiperf_udp_client_send_one(c, c->packet_id) == ERR_OK) {
+        c->bytes_delivered += c->buffer_len;
+      }
+      /* offered counters advance unconditionally (iperf increments packetID
+       * before the write and never rewinds it on failure) */
+      c->packet_id++;
+      c->bytes_transferred += c->buffer_len;
+
+      /* Bound the work per callback so a burst cannot monopolise the CPU; the
+       * remainder is offered on the next tick. This only caps catch-up work,
+       * it does not throttle the offered rate over time. */
+      if (++burst >= LWIPERF_UDP_CLIENT_MAX_BURST) {
+        break;
+      }
+    }
+  }
+
+  if (test_done) {
+    /* enter the FIN phase: retransmit the negative-id datagram until the
+     * server replies with its report (parsed in lwiperf_udp_client_recv) */
+    c->in_fin = 1;
+    c->fin_tries = LWIPERF_UDP_CLIENT_FIN_TRIES;
+    lwiperf_udp_client_fin_tick(c);
+    return;
+  }
+  sys_timeout(c->interval_ms, lwiperf_udp_client_tick, c);
+}
+
+/** Timer callback: (re)send the final datagram and await the server report */
+static void
+lwiperf_udp_client_fin_tick(void *arg)
+{
+  lwiperf_state_udp_client_t *c = (lwiperf_state_udp_client_t *)arg;
+
+  if (c->fin_tries == 0) {
+    /* server never answered; still report what we sent */
+    lwiperf_udp_client_finish(c, LWIPERF_UDP_DONE_CLIENT);
+    return;
+  }
+  c->fin_tries--;
+  /* negative sequence number signals end-of-test to the server */
+  lwiperf_udp_client_send_one(c, -c->packet_id);
+  sys_timeout(LWIPERF_UDP_CLIENT_FIN_MS, lwiperf_udp_client_fin_tick, c);
+}
+
+/** UDP receive callback: the server's report datagram ends the test */
+static void
+lwiperf_udp_client_recv(void *arg, struct udp_pcb *pcb, struct pbuf *p,
+                        const ip_addr_t *addr, u16_t port)
+{
+  lwiperf_state_udp_client_t *c = (lwiperf_state_udp_client_t *)arg;
+
+  LWIP_UNUSED_ARG(pcb);
+  LWIP_UNUSED_ARG(addr);
+  LWIP_UNUSED_ARG(port);
+
+  if (p != NULL) {
+    pbuf_free(p);
+  }
+  /* Any datagram from the server once we are in the FIN phase is its report
+   * acknowledgement; the payload stats are not surfaced (our report uses the
+   * locally-measured send totals). */
+  if ((c != NULL) && !c->done && c->in_fin) {
+    lwiperf_udp_client_finish(c, LWIPERF_UDP_DONE_CLIENT);
+  }
+}
+
+/**
+ * @ingroup iperf
+ * Start a UDP iperf client streaming to a remote iperf server.
+ */
+void *
+lwiperf_start_udp_client(const ip_addr_t *remote_addr, u16_t remote_port,
+                         u32_t rate_bps, s32_t amount,
+                         lwiperf_report_fn report_fn, void *report_arg)
+{
+  err_t err;
+  struct udp_pcb *pcb;
+  lwiperf_state_udp_client_t *c;
+  lwiperf_udp_client_hdr_t *chdr;
+  u16_t i;
+
+  LWIP_ASSERT_CORE_LOCKED();
+
+  if (remote_addr == NULL) {
+    return NULL;
+  }
+  if (rate_bps == 0) {
+    rate_bps = LWIPERF_UDP_CLIENT_RATE_DEF;
+  }
+
+  c = (lwiperf_state_udp_client_t *)LWIPERF_ALLOC(lwiperf_state_udp_client_t);
+  if (c == NULL) {
+    return NULL;
+  }
+  memset(c, 0, sizeof(lwiperf_state_udp_client_t));
+  c->base.tcp = 0;
+  c->base.server = 0;
+  c->report_fn = report_fn;
+  c->report_arg = report_arg;
+  ip_addr_copy(c->remote_addr, *remote_addr);
+  c->remote_port = remote_port;
+  c->buffer_len = LWIPERF_UDP_CLIENT_MSS;
+  c->rate_bps = rate_bps;
+  c->packet_id = 0;
+
+  /* amount: negative => time in hundredths of a second; positive => bytes */
+  if (amount < 0) {
+    c->time_mode = 1;
+    c->amount = ((u32_t)(-amount)) * 10U; /* -> milliseconds */
+  } else {
+    c->time_mode = 0;
+    c->amount = (u32_t)amount;
+  }
+
+  /* Fixed short pacing period; lwiperf_udp_client_tick() catches up on any
+   * datagrams owed since it last ran, so the achieved rate follows rate_bps
+   * regardless of how often the callback is actually serviced. */
+  c->interval_ms = LWIPERF_UDP_CLIENT_TICK_MS;
+
+  /* Pre-build the client header once; it rides in the first datagram (and any
+   * retransmits reuse the same buffer). flags==0 => plain unidirectional test. */
+  chdr = (lwiperf_udp_client_hdr_t *)(c->txbuf + sizeof(lwiperf_udp_datagram_t));
+  chdr->flags      = 0;
+  chdr->numThreads = lwip_htonl(1);
+  chdr->mPort      = lwip_htonl(remote_port);
+  chdr->bufferlen  = lwip_htonl(c->buffer_len);
+  chdr->mWinBand   = lwip_htonl(rate_bps);
+  chdr->mAmount    = c->time_mode ?
+                     lwip_htonl((u32_t)(-(s32_t)(c->amount / 10U))) :
+                     lwip_htonl(c->amount & 0x7FFFFFFFU);
+  /* fill the remaining payload with the iperf digit pattern */
+  for (i = sizeof(lwiperf_udp_datagram_t) + sizeof(lwiperf_udp_client_hdr_t);
+       i < c->buffer_len; i++) {
+    c->txbuf[i] = (u8_t)('0' + (i % 10));
+  }
+
+  pcb = udp_new_ip_type(IP_GET_TYPE(remote_addr));
+  if (pcb == NULL) {
+    LWIPERF_FREE(lwiperf_state_udp_client_t, c);
+    return NULL;
+  }
+  /* bind to an ephemeral local port so the server's report reaches our recv */
+  err = udp_bind(pcb, IP_ANY_TYPE, 0);
+  if (err != ERR_OK) {
+    udp_remove(pcb);
+    LWIPERF_FREE(lwiperf_state_udp_client_t, c);
+    return NULL;
+  }
+  c->pcb = pcb;
+  udp_recv(pcb, lwiperf_udp_client_recv, c);
+
+  lwiperf_list_add(&c->base);
+
+  c->time_started = sys_now();
+  /* kick off sending on the next timer service */
+  sys_timeout(c->interval_ms, lwiperf_udp_client_tick, c);
+  return c;
+}
+
+/**
+ * @ingroup iperf
+ * Start a UDP iperf client to the default port (5001) at ~1 Mbit/s for 10 s.
+ */
+void *
+lwiperf_start_udp_client_default(const ip_addr_t *remote_addr,
+                                 lwiperf_report_fn report_fn, void *report_arg)
+{
+  return lwiperf_start_udp_client(remote_addr, LWIPERF_UDP_PORT_DEFAULT,
+                                  LWIPERF_UDP_CLIENT_RATE_DEF,
+                                  LWIPERF_UDP_CLIENT_AMOUNT_DEF,
+                                  report_fn, report_arg);
+}
