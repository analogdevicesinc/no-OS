+/* iperf2 UDP wire protocol
+ * -----------------------------------------------------------------------------
+ * Every UDP datagram sent by an iperf2 client begins with a 16-byte header
+ * (all fields network byte order):
+ *   int32  id       running datagram sequence number (low 32 bits), starting at
+ *                   0. The final datagram carries the negated sequence number to
+ *                   signal the end of the test.
+ *   uint32 tv_sec   client send timestamp (seconds)
+ *   uint32 tv_usec  client send timestamp (microseconds)
+ *   int32  id2      sequence number high 32 bits (iperf >= 2.0.10; zero for the
+ *                   datagram counts we deal with here)
+ *
+ * iperf 2.0.5 used a 12-byte header without 'id2'; 2.0.10 and later (e.g. the
+ * build shipped on modern Linux) grew it to 16 bytes. The client reads the
+ * server report back at offset sizeof(UDP_datagram), so the header size must
+ * match the client or every server_hdr field lands one word off.
+ *
+ * When the test ends (final datagram received), the server replies with an
+ * "AckFIN" datagram: the UDP_datagram header followed by a 40-byte server_hdr
+ * carrying the measured statistics, which the client prints as the
+ * "server report". Layout mirrors iperf 2.0.x (include/Settings.hpp). */
+
+#define LWIPERF_UDP_HEADER_VERSION1 0x80000000U
