menu "LTC4284 Configuration"

choice LTC4284_EXAMPLE
	prompt "Example variant"
	default LTC4284_BASIC_EXAMPLE

config LTC4284_BASIC_EXAMPLE
	bool "Basic monitoring example"
	help
	  Continuously monitors LTC4284 telemetry (VIN, IIN, VOUT, power,
	  energy, temperature) and decodes fault bits.

config LTC4284_IIO_EXAMPLE
	bool "IIO example"
	depends on IIO
	help
	  Demonstrates IIO integration with LTC4284 telemetry. Requires
	  CONFIG_IIO=y.

config LTC4284_OVERCURRENT_EXAMPLE
	bool "Overcurrent protection example"
	help
	  Demonstrates overcurrent protection with fault decode, retry
	  narration, and configurable protection parameters. Shows the
	  OC retry loop and reports fault register values with
	  human-readable descriptions.

config LTC4284_DUAL_CORE_EXAMPLE
	bool "Dual-core overcurrent example (ARM + RISC-V)"
	depends on CAPI_COPROCESSOR && CAPI_MAILBOX
	help
	  The RISC-V core (CPU1) owns the LTC4284: it programs the overcurrent
	  profile, monitors the ALERT pin and serves telemetry requests. The
	  ARM core (CPU0) boots it with the CAPI coprocessor API, talks to it
	  through a shared table and the CAPI mailbox doorbell, and prints the
	  telemetry. Requires CONFIG_CAPI_COPROCESSOR=y and
	  CONFIG_CAPI_MAILBOX=y.

endchoice

endmenu
