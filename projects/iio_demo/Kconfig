menu "IIO Demo Configuration"

choice IIO_DEMO_EXAMPLE
	prompt "Example variant"
	default IIO_DEMO_IIO_EXAMPLE

config IIO_DEMO_IIO_EXAMPLE
	bool "Basic IIO example"

config IIO_DEMO_IIO_TIMER_TRIGGER_EXAMPLE
	bool "IIO timer trigger example"

config IIO_DEMO_IIO_SW_TRIGGER_EXAMPLE
	bool "IIO software trigger example"

config IIO_DEMO_LIBIIO_EXAMPLE
	bool "Basic example served by libiio"
	depends on LIBIIO
	help
	  adc_demo and dac_demo (and the part's own ADC with IIO_ADC_MAXIM)
	  served by libiio's iiod instead of iio_app, over the transport
	  picked in LIBIIO_TRANSPORT.

endchoice

config IIO_DEMO_NETWORKING
	bool "Enable ESP8266 Wi-Fi networking"
	default n
	select WIFI_NETWORKING
	help
	  Route IIO transport over an ESP8266 Wi-Fi module (UART AT commands)
	  instead of the serial backend. aducm3029/eval-adicup3029 only.

endmenu
