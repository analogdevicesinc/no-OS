menu "ad413x Configuration"

choice AD413X_EXAMPLE
	prompt "Example variant"
	default AD413X_DEMO_EXAMPLE

config AD413X_DEMO_EXAMPLE
	bool "Demo example"
	help
	  Demo example that initializes the AD413X AFE/ADC, performs continuous
	  conversion on selected channels and prints the results.

config AD413X_IIO_EXAMPLE
	bool "IIO example"
	depends on IIO
	help
	  IIO example that exposes the AD413X ADC through the IIO framework
	  via iio_ad413x, enabling host-side data capture over UART.

endchoice

choice AD413X_CARRIER
	prompt "Carrier board"
	default AD413X_ZED_CARRIER

config AD413X_ZED_CARRIER
	bool "ZedBoard carrier"
	help
	  Select when targeting the ZedBoard carrier. The IIO console uses
	  the PS UART1 peripheral routed to the ZedBoard USB-UART.

config AD413X_CORAZ7S_CARRIER
	bool "Cora Z7-07S carrier"
	help
	  Select when targeting the Cora Z7-07S carrier. The IIO console uses
	  the PS UART0 peripheral routed to the Cora Z7S USB-UART.

endchoice

choice AD413X_DEV
	prompt "Device variant"
	default AD413X_DEV_AD4130_8
	help
	  Select the AD413x family part populated on the evaluation board.

config AD413X_DEV_AD4129_4
	bool "AD4129-4"

config AD413X_DEV_AD4129_8
	bool "AD4129-8"

config AD413X_DEV_AD4130_4
	bool "AD4130-4"

config AD413X_DEV_AD4130_8
	bool "AD4130-8"
	help
	  Default AD4130-8 device (no extra compile define needed).

config AD413X_DEV_AD4131_4
	bool "AD4131-4"

config AD413X_DEV_AD4131_8
	bool "AD4131-8"

endchoice

endmenu
