menu "ad9082 Configuration"

choice AD9082_EXAMPLE
	prompt "Example variant"
	default AD9082_BASIC_EXAMPLE

config AD9082_BASIC_EXAMPLE
	bool "Basic example"
	help
	  Basic bring-up example: initializes the HMC7044 clocks, the
	  AXI-JESD204 RX/TX cores and the AD9082 (ad9081 driver), runs the
	  JESD204 FSM and prints the link status. No data is moved.

config AD9082_DMA_EXAMPLE
	bool "DMA example"
	help
	  DMA-based data capture and playback example for the AD9082 over the
	  AXI ADC/DAC cores and DMACs.

config AD9082_IIO_EXAMPLE
	bool "IIO example"
	depends on IIO
	help
	  IIO example that exposes the AD9082 through the IIO framework via
	  iio_axi_adc and iio_axi_dac, for host-side capture/playback over UART.

endchoice

endmenu
